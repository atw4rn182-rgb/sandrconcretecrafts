# Copy this file to local.properties on the machine that builds the APK.
# Never put Stripe secret keys, Supabase service-role keys, webhook secrets,
# or any other server secret here.

sdk.dir=C\:\\Users\\YOUR_USER\\AppData\\Local\\Android\\Sdk

# Public website origin used for Terminal API calls.
SR_API_BASE_URL=https://www.sandrconcretecrafts.com

# Same public browser values as js/env.js. Never the service-role key.
SR_SUPABASE_URL=
SR_SUPABASE_ANON_KEY=

# Debug/TEST builds always use SIMULATED_READER=true.
# Release/PRODUCTION builds always use SIMULATED_READER=false.
# Do not override those values from this file.

# Optional local release signing. Never commit these values or the keystore.
# SR_RELEASE_STORE_FILE=
# SR_RELEASE_STORE_PASSWORD=
# SR_RELEASE_KEY_ALIAS=
# SR_RELEASE_KEY_PASSWORD=
