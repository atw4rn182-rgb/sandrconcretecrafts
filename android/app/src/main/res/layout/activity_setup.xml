<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/buildPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@color/turquoise"
            android:fontFamily="monospace"
            android:padding="12dp"
            android:textColor="@color/cream"
            android:textSize="14sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/eyebrow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/setup_eyebrow"
            android:textColor="@color/turquoise"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/setup_welcome_title"
            android:textColor="@color/brown"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:lineSpacingExtra="4dp"
            android:text="@string/setup_welcome_body"
            android:textColor="@color/brown"
            android:textSize="17sp" />

        <LinearLayout
            android:id="@+id/checklistCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@color/cream"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/setup_progress_title"
                android:textColor="@color/brown"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/checklist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:lineSpacingExtra="6dp"
                android:textColor="@color/brown"
                android:textSize="16sp" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/busy"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="28dp"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/primary"
            android:layout_width="match_parent"
            android:layout_height="72dp"
            android:layout_marginTop="32dp"
            android:text="@string/setup_get_started"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/diagnosticsToggle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center"
            android:padding="8dp"
            android:text="@string/test_diagnostics"
            android:textColor="@color/turquoise"
            android:textSize="14sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/diagnostics"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="monospace"
            android:textColor="@color/brown"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
