# Supabase project credentials (Dashboard → Project Settings → API)
# Copy this file to .env for local use, or set the same names in Vercel.
# Never commit .env or the service-role key.

# Project URL (safe to expose in the browser with RLS enabled)
# Vercel: set for Production (and Preview if you test admin there)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Anon / public key only (safe in browser when RLS is correct)
# Vercel: set for Production (and Preview if you test admin there)
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Service role key — SERVER / LOCAL ADMIN TOOLS ONLY
# Never put this in browser code, HTML, js/env.js, or Vercel vars used by this static site.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY