# Supabase project credentials (Dashboard → Project Settings → API)
# Copy this file to .env and fill in real values. Never commit .env.

# Project URL (safe to expose in the browser with RLS enabled)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Anon / public key only (safe in browser when RLS is correct)
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Service role key — SERVER / LOCAL ADMIN TOOLS ONLY
# Never put this in browser code, HTML, or any client-side file.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
