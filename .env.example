# Supabase project credentials (Dashboard → Project Settings → API)
# Copy this file to .env for local use, or set the same names in Vercel.
# Never commit .env or secret keys.

# ---------------------------------------------------------------------------
# Public / build-time (safe in browser when RLS is correct)
# Written into js/env.js by: npm run build (scripts/write-public-env.js)
# ---------------------------------------------------------------------------

# Project URL
# Vercel: Production (and Preview if you test admin there)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Anon / public key only
# Vercel: Production (and Preview if you test admin there)
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Storefront cutover (default off). Set true only after migrations 07–08.
USE_LIVE_CATALOG=false

# Public Stripe Checkout feature flag (default off).
# When false, the shop keeps demo checkout.
# When true, cart Checkout POSTs to /api/create-checkout-session.
# This flag is NOT a secret — it is written into js/env.js.
USE_STRIPE_CHECKOUT=false

# ---------------------------------------------------------------------------
# Stripe — SERVER ONLY (Vercel Environment Variables → Production)
# Never put these in js/env.js, index.html, or any client script.
# Do not enable live charges until you explicitly set STRIPE_ALLOW_LIVE=true.
# ---------------------------------------------------------------------------

# Stripe Dashboard → Developers → API keys → Secret key (use sk_test_… first)
STRIPE_SECRET_KEY=

# Stripe Dashboard → Developers → Webhooks → signing secret (whsec_…)
# Endpoint URL: https://www.sandrconcretecrafts.com/api/stripe-webhook
STRIPE_WEBHOOK_SECRET=

# Publishable key (pk_test_… / pk_live_…). Optional for hosted Checkout redirect.
# Not required by the current Checkout Session flow. Keep out of js/env.js unless
# you later add Stripe.js / Elements.
STRIPE_PUBLISHABLE_KEY=

# Canonical site origin for Checkout success/cancel URLs (no trailing slash)
SITE_URL=https://www.sandrconcretecrafts.com

# Safety latch — leave unset/false so sk_live_ / rk_live_ keys are rejected
# Primary name the API checks: STRIPE_ALLOW_LIVE=true
# Alias also accepted: STRIPE_ALLOW_TRUE=true
STRIPE_ALLOW_LIVE=false

# Stripe Terminal — SERVER ONLY. Keep disabled until the native client,
# Terminal Location, and separate signed webhook are configured.
# Use a TEST mode secret here so Terminal stays isolated from live Checkout.
STRIPE_TERMINAL_ENABLED=false
STRIPE_TERMINAL_SECRET_KEY=
STRIPE_TERMINAL_LOCATION_ID=
STRIPE_TERMINAL_WEBHOOK_SECRET=

# Which staff APK the Admin → Payments installer offers.
# test = simulated debug APK (current). production = real Tap-to-Pay APK later.
# Server-only. Never write this into js/env.js.
SR_POS_APP_CHANNEL=test
# Optional HMAC secret for short-lived APK download tickets.
# If unset, the existing server-only SUPABASE_SERVICE_ROLE_KEY is used.
POS_APP_DOWNLOAD_SECRET=

# ---------------------------------------------------------------------------
# Server-only Supabase (webhook order writes) — NEVER in js/env.js / browser
# Vercel: Production only, available to Serverless Functions
# ---------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# ---------------------------------------------------------------------------
# Email receipts — SERVER ONLY (Resend REST API; no browser exposure)
# Sales remain valid if these are missing or receipt delivery fails.
# ---------------------------------------------------------------------------
RESEND_API_KEY=
RECEIPT_FROM_EMAIL=S&R Concrete Crafts <receipts@sandrconcretecrafts.com>
# Optional
RECEIPT_REPLY_TO_EMAIL=
RECEIPT_BCC_EMAIL=
